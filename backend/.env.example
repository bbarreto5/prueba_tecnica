APP_NAME=Incident & Request Management API
ENVIRONMENT=development
DATABASE_URL="postgresql+psycopg://user:password@localhost:5432/dbname"

# Development-only seed credentials (see app/infrastructure/database/seed.py).
# Never put real passwords here.
SEED_ADMIN_PASSWORD=change-me
SEED_SUPPORT_PASSWORD=change-me
SEED_COMPANY_USER_PASSWORD=change-me

# JWT auth (see app/core/security.py). Never put the real secret here.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Email notifications (see app/infrastructure/email/). Optional: if any of
# these is blank, email notifications are disabled and the app runs
# normally — see app/infrastructure/email/config.py.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=true
