# Base URL of the backend API (no trailing slash, no /api/v1 suffix — the
# API client appends that). Every backend request is made from Next.js
# Server Components/Server Actions, never from client-side browser code, so
# this is intentionally NOT prefixed with NEXT_PUBLIC_ (see AGENTS.md: don't
# expose variables via NEXT_PUBLIC_* unless the client actually needs them).
API_URL=http://localhost:8000
